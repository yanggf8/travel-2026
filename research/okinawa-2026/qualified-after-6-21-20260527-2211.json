SELECT source_id, depart_date, return_date, nights, hotel_name, price_per_person_twd
FROM stage0_tour_group_offers 
WHERE run_id = 'stage0-20260525-093508' 
  AND product_kind = 'fit'
  AND depart_date >= '2026-06-21'
  AND depart_date != '2026-06-28'
  AND return_date <= '2026-06-27'
  AND hotel_name IS NOT NULL
  AND hotel_name != '自選市區飯店'
ORDER BY depart_date, price_per_person_twd;


