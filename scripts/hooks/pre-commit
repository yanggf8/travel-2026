#!/bin/bash
# Pre-commit hook: Rust build check + data validation before commit.
# (npm-free — the CLI is the Rust travel binary; root package.json is retired.)
# Install: ./bin/travel-dev hooks-install   (or copy scripts/hooks/* to .git/hooks/)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT/rust"

echo "Building travel-cli (compile check)..."
if ! cargo build -p travel-cli --quiet; then
  echo "❌ Rust build failed. Fix errors before committing."
  exit 1
fi
echo "✅ Build passed"

echo ""
echo "Running data validation..."
cd "$REPO_ROOT"
if ! ./rust/target/debug/travel validate data; then
  echo "❌ Data validation failed. Fix errors before committing."
  exit 1
fi
echo "✅ Data validation passed"
